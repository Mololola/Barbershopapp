# Copy to .env and fill in with your Supabase project's values (Project Settings > API / Database)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Filled in when Stripe integration starts (Phase 2)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Shared with the GitHub Actions secret JOBS_SECRET — see .github/workflows/scheduled-jobs.yml
JOBS_SECRET=
# Leave empty to turn error reporting off (local dev)
SENTRY_DSN=
# The business website allowed to call this API from a browser, e.g. http://localhost:8766
# locally or the Render static site in production. Empty: browsers are refused.
WEB_APP_URL=
# Dev only: true logs every SQL statement the backend runs.
SQL_ECHO=false
